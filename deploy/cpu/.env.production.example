CASEI_ENVIRONMENT=production
CASEI_ALLOW_DEV_IDENTITY_HEADERS=false
CASEI_SQLITE_HISTORY=disabled
CASEI_STRICT_BUNDLE_CHECKSUMS=true
CASEI_PIPELINE_DATA_SOURCE=supabase_active
CASEI_DB_MODE=supabase
CASEI_ARTIFACT_MODE=local

CASEI_WEB_URL=https://TU-WEB.vercel.app
CASEI_API_PUBLIC_URL=https://TU-API.example.com
CASEI_CORS_ORIGINS=https://TU-WEB.vercel.app

CASEI_SUPABASE_URL=https://TU-PROYECTO.supabase.co
CASEI_SUPABASE_ANON_KEY=TU_ANON_KEY
CASEI_SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_SOLO_SERVIDOR

CASEI_ML_WORKER_ENABLED=true
CASEI_AUTO_INFERENCE_ENABLED=false
CASEI_ML_WORKER_ID=worker-production-1
CASEI_ML_POLL_SECONDS=5
CASEI_ML_JOB_TIMEOUT_SECONDS=900
CASEI_ML_EVENT_DEBOUNCE_SECONDS=60
CASEI_MODEL_ACTIVATION_MODE=manual

CASEI_SLM_ENABLED=true
CASEI_SEARCH_MODE=auto
CASEI_SEMANTIC_SEARCH_ENABLED=true
CASEI_SEARCH_RETRIEVAL_MODE=hybrid
OLLAMA_GATEWAY_URL=https://TU-POD-8001.proxy.runpod.net
OLLAMA_GATEWAY_API_KEY=SECRETO_COMPARTIDO_CON_RUNPOD
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT_SECONDS=12
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=8
OLLAMA_EMBEDDING_INDEX_TIMEOUT_SECONDS=120
OLLAMA_WARMUP_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=256
CASEI_SEMANTIC_TOP_K=50
CASEI_SEMANTIC_MIN_SIMILARITY=0.35
CASEI_SEMANTIC_PROTOTYPE_MIN_SIMILARITY=0.72
CASEI_RRF_K=60
CASEI_SEARCH_EXPLAIN_DEFAULT=false
CASEI_EMBEDDING_BATCH_SIZE=32
CASEI_EMBEDDING_CACHE_MAX_SIZE=512
CASEI_EMBEDDING_CACHE_TTL_SECONDS=1800
