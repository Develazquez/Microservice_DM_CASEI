CASEI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
CASEI_WEB_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CASEI_API_PUBLIC_URL=http://127.0.0.1:8000

CASEI_API_RELOAD=true
VERCEL_URL=
CASEI_SQLITE_HISTORY=disabled
CASEI_STRICT_BUNDLE_CHECKSUMS=false
CASEI_ENVIRONMENT=development
CASEI_ALLOW_DEV_IDENTITY_HEADERS=true
CASEI_AUTH_TIMEOUT_SECONDS=5
CASEI_SUPABASE_URL=
CASEI_SUPABASE_ANON_KEY=
CASEI_SUPABASE_SERVICE_ROLE_KEY=
CASEI_DB_MODE=supabase
CASEI_PIPELINE_DATA_SOURCE=auto

# Worker y ejecuciones ML. Mantener automatizacion apagada durante la demo manual.
CASEI_ML_WORKER_ENABLED=true
CASEI_AUTO_INFERENCE_ENABLED=false
CASEI_ML_WORKER_ID=worker-local-1
CASEI_ML_POLL_SECONDS=5
CASEI_ML_JOB_TIMEOUT_SECONDS=900
CASEI_ML_EVENT_DEBOUNCE_SECONDS=60
CASEI_MODEL_ACTIVATION_MODE=manual

# Buscador SLM + BM25. En Vercel usar CASEI_SLM_ENABLED=false.
CASEI_SLM_ENABLED=false
CASEI_SEARCH_MODE=auto
CASEI_SEMANTIC_SEARCH_ENABLED=false
CASEI_SEARCH_RETRIEVAL_MODE=hybrid
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_GATEWAY_URL=
OLLAMA_GATEWAY_API_KEY=
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT_SECONDS=12
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=8
OLLAMA_EMBEDDING_INDEX_TIMEOUT_SECONDS=120
OLLAMA_WARMUP_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=256
CASEI_SLM_CACHE_MAX_SIZE=256
CASEI_SLM_CACHE_TTL_SECONDS=600
CASEI_SLM_FAILURE_THRESHOLD=3
CASEI_SLM_COOLDOWN_SECONDS=60
CASEI_SEMANTIC_TOP_K=50
CASEI_SEMANTIC_MIN_SIMILARITY=0.35
CASEI_SEMANTIC_PROTOTYPE_MIN_SIMILARITY=0.72
CASEI_RRF_K=60
CASEI_SEARCH_EXPLAIN_DEFAULT=false
CASEI_EMBEDDING_BATCH_SIZE=32
CASEI_EMBEDDING_CACHE_MAX_SIZE=512
CASEI_EMBEDDING_CACHE_TTL_SECONDS=1800

# Configuracion del proceso Ollama. En GPU pequena evaluar MAX_LOADED_MODELS=1.
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_NUM_PARALLEL=1

# Solo dentro del Pod de RunPod.
CASEI_SLM_GATEWAY_API_KEY=
OLLAMA_MODELS=/workspace/ollama/models
